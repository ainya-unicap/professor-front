SECRET_KEY=troque-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# URL da API (nest-api). Em dev local, porta padrão do Nest é 3000.
API_BASE_URL=http://localhost:3000/api
# Site key pública do reCAPTCHA. Vazia = widget não é exibido (ok em dev,
# desde que o backend também esteja sem RECAPTCHA_SECRET configurado).
RECAPTCHA_SITE_KEY=
# Mesmo valor do RECAPTCHA_BYPASS_TOKEN configurado no backend (nest-api).
# Usado como recaptchaToken quando não há site key/widget — só funciona se
# o backend tiver esse exato valor configurado. Nunca usar em produção real.
RECAPTCHA_BYPASS_TOKEN=
